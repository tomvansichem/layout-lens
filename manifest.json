{
  "manifest_version": 3,
  "name": "Layout Lens",
  "version": "1.1.0",
  "description": "Hover inspector for padding/margin plus a CSS-vs-rendered size discrepancy checker. Activated only by a keyboard shortcut.",
  "homepage_url": "https://github.com/tomvansichem/layout-lens",
  "minimum_chrome_version": "121",

  "browser_specific_settings": {
    "gecko": {
      "id": "layout-lens@tomvansichem",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["activeTab", "storage"],

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "toggle-layout-lens": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Toggle the Layout Lens inspector on the active tab"
    },
    "cycle-layout-lens-unit": {
      "suggested_key": {
        "default": "Alt+U",
        "mac": "Alt+U"
      },
      "description": "Cycle the displayed unit: px → rem → em"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
